#!/bin/sh
# Verify that a product build consumes the reviewed shared source revision.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$ROOT/CORE.lock"
SRC="${AROS_SRC:-$ROOT/../aros-core}"
case "${1:-}" in ''|--source-only) ;; *) echo "usage: $0 [--source-only]" >&2; exit 2 ;; esac
[ -e "$SRC/.git" ] || { echo "Missing shared source: $SRC; run graft/fetch-core" >&2; exit 1; }
actual="$(git -C "$SRC" rev-parse HEAD)"
if [ "$actual" != "$CORE_REVISION" ]; then
    echo "Core revision mismatch: expected $CORE_REVISION, found $actual" >&2
    exit 1
fi
if [ -n "$(git -C "$SRC" status --porcelain)" ]; then
    echo "Shared core has visible changes; use a reviewed clean revision" >&2
    exit 1
fi
BUILD_DIR="${AROS_BUILD:-${BUILD:-$ROOT/../Build/pomaros-hosted}}"
if [ "${1:-}" != --source-only ] && [ -f "$BUILD_DIR/Makefile" ]; then
    configured_source="$(LC_ALL=C sed -n 's/^SRCDIR[[:space:]]*:=[[:space:]]*//p' "$BUILD_DIR/Makefile" | head -1)"
    expected_source="$(cd "$SRC" && pwd -P)"
    if [ "$configured_source" != "$expected_source" ]; then
        echo "Build tree uses another source: $configured_source (expected $expected_source)" >&2
        exit 1
    fi
    configured_revision="$(cut -d : -f 1 "$BUILD_DIR/.pomaros-configure-core" 2>/dev/null || true)"
    if [ "$configured_revision" != "$CORE_REVISION" ]; then
        echo "Build revision mismatch: configured ${configured_revision:-unknown}, expected $CORE_REVISION; select a fresh build directory" >&2
        exit 1
    fi
fi
printf 'Core %s (%s; x18=%s)\n' "$CORE_REVISION" "$CORE_TARGET" "$CORE_X18_POLICY"
